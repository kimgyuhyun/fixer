# 이 파일을 .env로 복사해서 사용한다. .env는 커밋되지 않는다.
# docker compose와 apps/api가 같은 .env를 읽는다.

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=fixer
POSTGRES_PASSWORD=fixer_local_pw
POSTGRES_DB=fixer
# Windows에 네이티브 PostgreSQL(postgresql-x64-17 등)이 설치돼 있으면 5432를 이미
# 점유하고 있다. Docker Desktop이 포트 충돌을 조용히 넘기는 경우가 있어, 컨테이너는
# 떠 있는데 앱은 네이티브 쪽에 붙어 `28P01 password authentication failed`가 난다.
# 그럴 때는 이 값을 5433 등으로 바꾸고 아래 DATABASE_URL의 포트도 함께 맞춘다.
#   확인:  Get-NetTCPConnection -LocalPort 5432 -State Listen
#   소유자가 postgres.exe면 네이티브, wslrelay면 Docker다.
POSTGRES_PORT=5432

# --- API ---
API_PORT=3001
# Access 토큰(JWT) 서명 키. 이 값을 아는 사람은 아무 회원으로도 로그인할 수 있으므로
# 커밋하지 않고 환경마다 다른 난수를 넣는다.
#   생성:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 값을 비워 둔 것은 의도다. 그럴듯한 예시 값을 적어두면 그대로 복사해서 쓰게 되고,
# 저장소에 공개된 키로 서명하는 순간 누구나 아무 회원의 토큰을 만들 수 있다.
# 비어 있으면 API가 켜지지 않으므로 빠뜨린 것을 바로 알 수 있다.
AUTH_JWT_SECRET=
# Prisma가 읽는 접속 문자열. 위 POSTGRES_* 값과 일치해야 한다.
# localhost가 아니라 127.0.0.1을 쓴다. Windows에서 localhost는 IPv6(::1)로 먼저
# 해석되는데 Docker Desktop이 ::1 연결을 받아만 두고 컨테이너로 넘기지 않아,
# 접속이 거부되는 대신 무한 대기에 빠진다.
DATABASE_URL=postgresql://fixer:fixer_local_pw@127.0.0.1:5432/fixer?schema=public

# --- Web ---
WEB_PORT=3000
# 브라우저는 Next의 rewrites를 거치므로 절대주소가 필요 없다.
# Next가 Nest로 프록시할 때 쓰는 주소이며, 위와 같은 이유로 IPv4로 고정한다.
API_INTERNAL_URL=http://127.0.0.1:3001
