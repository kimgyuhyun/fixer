# 이 파일을 .env로 복사해서 사용한다. .env는 커밋되지 않는다.
# docker compose와 apps/api가 같은 .env를 읽는다.

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=fixer
POSTGRES_PASSWORD=fixer_local_pw
POSTGRES_DB=fixer
POSTGRES_PORT=5432

# --- API ---
API_PORT=3001
# Prisma가 읽는 접속 문자열. 위 POSTGRES_* 값과 일치해야 한다.
DATABASE_URL=postgresql://fixer:fixer_local_pw@localhost:5432/fixer?schema=public

# --- Web ---
WEB_PORT=3000
# 브라우저는 Next의 rewrites를 거치므로 절대주소가 필요 없다.
# 서버 컴포넌트에서 직접 호출할 때만 이 주소를 쓴다.
API_INTERNAL_URL=http://localhost:3001
