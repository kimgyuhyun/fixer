// 도메인 모델은 아직 정의하지 않았다. docs/features/planner/planner.md의
// 회원가입 / 일거리 / 평점 / 포인트 설계가 확정되면 이 파일에 모델을 추가하고
// `pnpm db:migrate`로 마이그레이션 파일을 생성해 커밋한다.
// 운영 DB에 직접 DDL을 실행하지 않는다.

generator client {
  provider = "prisma-client"
  // Nest가 tsc로 src 아래만 컴파일하므로 생성물도 src 안에 둔다.
  output   = "../src/generated/prisma"
  // Nest 런타임이 CommonJS라 생성 클라이언트도 CJS로 맞춘다.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  // 접속 문자열은 prisma.config.ts가 루트 .env에서 읽어 주입한다.
}

/// 회원. (이슈 #2)
///
/// 서비스의 모든 행위 주체다. 이 이슈는 "가입되는 최소한의 User"까지만 만든다.
/// 주소(#3)·동의서(#7)·평점·잔액 캐시는 각 이슈가 자기 컬럼을 들고 온다.
/// role과 deactivatedAt은 ADR-AUTH-3(계정 생명주기)이 확정된 뒤에 붙인다.
model User {
  id           String   @id @default(cuid())
  /// 소문자로 정규화해서 저장한다. 대소문자만 다른 중복 계정을 막는다.
  email        String   @unique
  /// bcrypt 해시. 평문 저장 금지.
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// 로그인 세션들. (#4)
  refreshTokens RefreshToken[]
  passwordResets PasswordReset[]
}

/// 이메일 인증 코드 발급 이력. (이슈 #1, ADR-AUTH-4)
///
/// 발급할 때마다 행을 추가한다. 유효한 코드는 "가장 최근의, 소비되지 않은,
/// 만료되지 않은" 행 하나뿐이다. 쿨다운은 최근 행의 createdAt으로,
/// 시간당 발송 수는 최근 1시간 내 행 수로 판정한다.
model EmailVerification {
  id           String    @id @default(cuid())
  email        String
  /// 평문 저장 금지. 유출돼도 코드를 알 수 없어야 한다.
  codeHash     String
  expiresAt    DateTime
  /// 인증에 사용된 시각. 1회용이므로 값이 있으면 재사용 불가.
  consumedAt   DateTime?
  /// 틀린 횟수. maxAttempts에 도달하면 이 코드는 폐기된다.
  attemptCount Int       @default(0)
  createdAt    DateTime  @default(now())

  // 쿨다운(최근 1건)과 시간당 발송 수(최근 1시간) 판정에 함께 쓰인다.
  @@index([email, createdAt])
}

/// 로그인 세션 하나. (이슈 #4, ADR-AUTH-1)
///
/// 로그인할 때마다 행을 추가한다. 회원당 여러 행이 쌓인다 — 휴대폰과 PC에
/// 동시에 로그인할 수 있어야 하기 때문이다. 회전(rotation)하지 않으므로
/// Access를 갱신해도 이 행은 그대로 있다.
model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  /// 평문 저장 금지. 조회 키라서 유니크는 userId가 아니라 여기에 건다.
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 전체 무효화(deleteMany(userId))와 만료 행 정리에 쓰인다.
  @@index([userId])
}

/// 비밀번호 재설정 링크 토큰. 발급마다 행을 쌓는다 (ADR-AUTH-4와 같은 방식).
model PasswordReset {
  id         String    @id @default(cuid())
  userId     String
  /// 평문 저장 금지. 유출돼도 토큰을 알 수 없어야 한다.
  tokenHash  String    @unique
  expiresAt  DateTime
  /// 사용된 시각. 1회용이므로 값이 있으면 재사용 불가.
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
