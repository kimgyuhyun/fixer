// 도메인 모델은 아직 정의하지 않았다. docs/features/planner/planner.md의
// 회원가입 / 일거리 / 평점 / 포인트 설계가 확정되면 이 파일에 모델을 추가하고
// `pnpm db:migrate`로 마이그레이션 파일을 생성해 커밋한다.
// 운영 DB에 직접 DDL을 실행하지 않는다.

generator client {
  provider = "prisma-client"
  // Nest가 tsc로 src 아래만 컴파일하므로 생성물도 src 안에 둔다.
  output   = "../src/generated/prisma"
  // Nest 런타임이 CommonJS라 생성 클라이언트도 CJS로 맞춘다.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  // 접속 문자열은 prisma.config.ts가 루트 .env에서 읽어 주입한다.
}

/// 회원. (이슈 #2)
///
/// 서비스의 모든 행위 주체다. 이 이슈는 "가입되는 최소한의 User"까지만 만든다.
/// 주소(#3)·동의서(#7)·평점·잔액 캐시는 각 이슈가 자기 컬럼을 들고 온다.
/// role과 deactivatedAt은 ADR-AUTH-3(계정 생명주기)이 확정되며 붙었다.
model User {
  id           String   @id @default(cuid())
  /// 소문자로 정규화해서 저장한다. 대소문자만 다른 중복 계정을 막는다.
  email        String   @unique
  /// bcrypt 해시. 평문 저장 금지.
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  /// 표시용 캐시. **진실의 원천은 원장이다** (ADR-PAY-1).
  cachedBalance Int     @default(0)
  /// 비활성화 시각. **상태 컬럼을 만들지 않는다** — 이것 하나로 판정한다 (ADR-AUTH-3).
  deactivatedAt DateTime?
  /// 개인정보 파기 시각. (#39)
  ///
  /// 상태 컬럼이 아니라 **시각 기록**이라 ADR-AUTH-3의 기각 사유에 걸리지
  /// 않는다. 이게 없으면 배치가 어제 파기한 계정을 오늘 또 훑는다.
  purgedAt      DateTime?
  /// 관리자 여부. **별도 테이블을 만들지 않는다** (spec §11.1, #35).
  ///
  /// 화면에서 관리자를 만드는 기능은 두지 않는다 — 최초 관리자는 seed로만
  /// 만든다. 이 값을 토큰에 복사하지 않는 이유는 가드가 요청마다 여기를
  /// 읽어야 권한 회수가 즉시 반영되기 때문이다 (ADR-AUTH-3과 같은 판단).
  role          UserRole  @default(USER)

  /// 로그인 세션들. (#4)
  refreshTokens     RefreshToken[]
  passwordResets    PasswordReset[]
  pointTransactions PointTransaction[]
  addresses         UserAddress[]
  agreements        Agreement[]
  payments          Payment[]
  jobPosts          JobPost[]
  penalties         Penalty[]
  exchangeAccount   ExchangeAccount?
  applications      Application[]
  notifications     Notification[]
  adminAuditLogs    AdminAuditLog[]

  /// 파기 배치가 "비활성화됐고 아직 파기 안 된" 행만 훑는다 (#39)
  @@index([deactivatedAt, purgedAt])
}

/// 회원 등급. `packages/shared/src/admin.ts`의 USER_ROLES와 같아야 한다.
enum UserRole {
  USER
  ADMIN
}

/// 관리자 조치 기록. (이슈 #35, spec §11.5 "누가·언제·무엇을·왜")
///
/// **레코드를 지우지 않는다.** 분쟁 대응 근거다 — Penalty와 같은 이유이고
/// 보관 기간도 같은 3년이다 (RETENTION.DISPUTE_MS).
///
/// #33(제재 해제)·#34(환전 승인·계좌 열람)가 같은 표에 쌓는다. 그래서
/// action과 targetType을 문자열로 두고 도메인별 표를 나누지 않는다.
model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  /// 무엇을 했나. 예: JOB_POST_FORCE_CANCEL
  action     String
  /// 무엇에 했나. 예: JobPost
  targetType String
  targetId   String
  /// 왜. 강제 취소는 사유가 필수지만 #34의 계좌번호 열람처럼 사유가 없는
  /// 조치도 있어 컬럼 자체는 nullable이다. 필수 여부는 서비스가 판정한다.
  reason     String?
  createdAt  DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id])

  /// "이 공고에 무슨 조치가 있었나" (#35 AC4)
  @@index([targetType, targetId])
  /// "이 관리자가 무엇을 했나"
  @@index([adminId, createdAt])
}

/// 회원의 주소. (이슈 #3, ADR-AUTH-2)
///
/// 회원당 여러 행을 허용하고 라벨로 구분한다. 그래서 userId에 유니크를 걸지 않는다.
/// 통 문자열 컬럼을 두지 않고 분해해서 담는다 — 관리자 지역 필터가 시/도 →
/// 시/군/구 두 단계로 좁히기 때문이다(`spec-fixed.md` §11).
model UserAddress {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 여러 주소를 구분하는 이름. 정하지 않으면 "기본"
  label        String
  /// 5자리 새 우편번호 (카카오 zonecode)
  postalCode   String
  roadAddress  String
  jibunAddress String
  /// 관리자 지역 필터 1단계 (spec-fixed §11)
  sido         String
  /// 관리자 지역 필터 2단계. 세종특별자치시처럼 없는 지역은 빈 문자열
  sigungu      String
  /// 좌표 변환 실패를 저장 실패로 만들지 않는다 (AC3)
  lat          Float?
  lng          Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  /// 관리자 지역 필터가 시/도 → 시/군/구 두 단계로 좁힌다
  @@index([sido, sigungu])
}

/// 이메일 인증 코드 발급 이력. (이슈 #1, ADR-AUTH-4)
///
/// 발급할 때마다 행을 추가한다. 유효한 코드는 "가장 최근의, 소비되지 않은,
/// 만료되지 않은" 행 하나뿐이다. 쿨다운은 최근 행의 createdAt으로,
/// 시간당 발송 수는 최근 1시간 내 행 수로 판정한다.
model EmailVerification {
  id           String    @id @default(cuid())
  email        String
  /// 평문 저장 금지. 유출돼도 코드를 알 수 없어야 한다.
  codeHash     String
  expiresAt    DateTime
  /// 인증에 사용된 시각. 1회용이므로 값이 있으면 재사용 불가.
  consumedAt   DateTime?
  /// 틀린 횟수. maxAttempts에 도달하면 이 코드는 폐기된다.
  attemptCount Int       @default(0)
  createdAt    DateTime  @default(now())

  // 쿨다운(최근 1건)과 시간당 발송 수(최근 1시간) 판정에 함께 쓰인다.
  @@index([email, createdAt])
}

/// 로그인 세션 하나. (이슈 #4, ADR-AUTH-1)
///
/// 로그인할 때마다 행을 추가한다. 회원당 여러 행이 쌓인다 — 휴대폰과 PC에
/// 동시에 로그인할 수 있어야 하기 때문이다. 회전(rotation)하지 않으므로
/// Access를 갱신해도 이 행은 그대로 있다.
model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  /// 평문 저장 금지. 조회 키라서 유니크는 userId가 아니라 여기에 건다.
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 전체 무효화(deleteMany(userId))와 만료 행 정리에 쓰인다.
  @@index([userId])
}

/// 비밀번호 재설정 링크 토큰. 발급마다 행을 쌓는다 (ADR-AUTH-4와 같은 방식).
model PasswordReset {
  id         String    @id @default(cuid())
  userId     String
  /// 평문 저장 금지. 유출돼도 토큰을 알 수 없어야 한다.
  tokenHash  String    @unique
  expiresAt  DateTime
  /// 사용된 시각. 1회용이므로 값이 있으면 재사용 불가.
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// 포인트 증감 내역. **잔액은 이 표의 합이다** (spec-fixed §6.1).
model PointTransaction {
  id              String               @id @default(cuid())
  userId          String
  type            PointTransactionType
  /// 부호까지 담는다. HOLD는 음수, RELEASE는 양수. 합계가 곧 잔액이다.
  amount          Int
  /// 웹훅 중복 수신 방어. **DB 제약이 최후 방어선이다** (ADR-PAY-3).
  idempotencyKey  String               @unique
  /// 어느 결제 건에서 나왔나. FIFO 소진과 환불 대상 선택에 쓴다 (ADR-PAY-7).
  sourcePaymentId String?
  /// 무엇 때문에 생긴 행인가 (공고 id, 환전 요청 id 등). 추적용.
  referenceId     String?
  createdAt       DateTime             @default(now())
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([sourcePaymentId])
}

enum PointTransactionType {
  CHARGE
  HOLD
  RELEASE
  PAYOUT
  EXCHANGE_REQUEST
  EXCHANGE_REVERT
  REFUND
}

/// 동의서 템플릿. 파일은 git으로, 메타데이터는 여기로 (ADR-AGR-4).
model AgreementTemplate {
  version      Int      @id
  fileKey      String
  sha256       String
  /// 서명이 들어갈 사각형(PDF 좌표). 여기서 좌표를 통제한다 (ADR-AGR-1).
  signatureBox Json
  isActive     Boolean  @default(false)
  activatedAt  DateTime @default(now())

  @@index([isActive])
}

/// 서명이 병합된 최종 PDF와 그 메타데이터 (spec-fixed §2.3).
model Agreement {
  id              String   @id @default(cuid())
  userId          String
  templateVersion Int
  /// 상대경로만 저장한다. 절대경로 금지 (§2.3).
  filePath        String
  /// 파기 후에도 남길 값 (§9).
  sha256          String
  agreedAt        DateTime @default(now())
  ip              String
  userAgent       String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, agreedAt])
}

/// 결제 건 하나. (이슈 #28)
///
/// 원장만으로는 **어느 결제 건이 얼마 남았는지**를 알 수 없는데, ADR-PAY-7의
/// FIFO 환불이 그 값을 필요로 한다(#29). 그래서 결제 건을 따로 들고 있는다.
model Payment {
  /// 포트원이 준 결제 건 식별자. **우리가 만들지 않는다** (ADR-PAY-3).
  id             String        @id
  userId         String
  /// 결제 시작 때 **서버가 정한** 금액. 확정 때 포트원이 준 값과 대조한다.
  amount         Int
  status         PaymentStatus @default(PENDING)
  /// 카드 취소 기한. **값은 지금 비워 둔다** — 실결제 전환 때 채운다.
  ///
  /// lot 잔여는 컬럼으로 두지 않는다. 원장에서 계산한다 (ADR-PAY-7) —
  /// 숫자가 두 벌이면 어긋났을 때 어느 쪽이 맞는지 판단할 근거가 없다.
  refundableUntil DateTime?
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// FIFO 소진이 오래된 것부터 훑는다 (ADR-PAY-7)
  @@index([userId, createdAt])
}

enum PaymentStatus {
  /// 결제창을 띄웠고 아직 확정되지 않았다
  PENDING
  /// 포트원이 PAID라고 했고 금액도 맞았다
  PAID
  /// 전액 취소됐다
  CANCELLED
}

/// 공고 카테고리. 관리자 화면 없이 seed로만 관리한다 (spec-fixed §3.1).
model Category {
  id              String  @id @default(cuid())
  name            String
  slug            String  @unique
  sortOrder       Int
  /// 상세 내용 입력란에 뜨는 안내 문구. 문구 수정에 재배포가 필요 없다.
  placeholderText String
  isActive        Boolean @default(true)

  jobPosts JobPost[]

  // 목록은 "활성만 정렬순"으로만 읽는다. 그 한 가지 접근을 위한 인덱스다.
  @@index([isActive, sortOrder])
}

/// 공고. (이슈 #12, `spec-fixed.md` §3)
model JobPost {
  id         String        @id @default(cuid())
  employerId String
  categoryId String
  title      String
  status     JobPostStatus @default(DRAFT)
  /// 필수항목 6개가 바뀔 때만 오른다 (§3.4). 시작값 1.
  version    Int           @default(1)

  // ── 필수항목 6개. 이 값들이 version을 올린다 (§3.4) ──
  /// 기본값은 가입 주소. **서버가 채운다** — 화면이 채우면 옛 값을 보낼 수 있다.
  workAddress         String
  /// 지역 필터 1단계 (#13). 문자열을 파싱하지 않고 분해해서 담는다 (ADR-AUTH-2와 같은 이유)
  workSido            String  @default("")
  /// 지역 필터 2단계. 세종특별자치시처럼 없는 지역은 빈 문자열
  workSigungu         String  @default("")
  workStartAt         DateTime
  workEndAt           DateTime
  headcount           Int
  /// 1인당 보상금(포인트). 예산 = headcount × 이 값
  rewardPerPerson     Int
  requiredDescription String

  /// 확정 인원. **비정규화 카운터다** (ADR-APP-1, #18).
  ///
  /// 행을 세지 않고 이 값을 조건부 UPDATE로 올린다 —
  /// `WHERE acceptedCount < headcount`가 원자적이라 별도 락 없이 정원 초과가
  /// 막힌다 (§4.4). 행을 세는 방식은 두 트랜잭션이 똑같은 수를 보고 둘 다
  /// 통과하는 그 틈을 못 막는다.
  acceptedCount Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// 물리 삭제 없음 (§3.3). 상태와 이 값으로 관리한다.
  deletedAt DateTime?

  employer User             @relation(fields: [employerId], references: [id], onDelete: Cascade)
  category Category         @relation(fields: [categoryId], references: [id])
  versions JobPostVersion[]
  applications Application[]

  /// 목록은 "OPEN을 최신순으로"만 읽는다 (ADR-JOB-5)
  @@index([status, createdAt])
  /// 지역 필터가 시/도 → 시/군/구 두 단계로 좁힌다 (#13)
  @@index([workSido, workSigungu, status])
  @@index([employerId])
  @@index([categoryId])
}

/// 공고 버전 스냅샷. (ADR-JOB-1)
///
/// 버전마다 **필수항목 6개 전부를 정규 컬럼으로** 남긴다. diff JSON이면
/// 중간 하나가 틀어질 때 그 이후 모든 복원이 틀어지는데, `appliedVersion`은
/// 화면용 숫자가 아니라 분쟁 시 근거가 되는 계약 내용이다.
model JobPostVersion {
  id        String @id @default(cuid())
  jobPostId String
  version   Int

  workAddress         String
  workStartAt         DateTime
  workEndAt           DateTime
  headcount           Int
  rewardPerPerson     Int
  requiredDescription String

  createdAt DateTime @default(now())
  jobPost   JobPost  @relation(fields: [jobPostId], references: [id], onDelete: Cascade)

  /// 계약 복원이 `WHERE jobPostId = ? AND version = ?` 한 줄이어야 한다
  @@unique([jobPostId, version])
}

enum JobPostStatus {
  /// 작성 중. 포인트 잠금 전
  DRAFT
  /// 모집 중. 포인트 HOLD 완료
  OPEN
  /// 모집 마감 (정원 충족 또는 시작 시각 도달)
  CLOSED
  /// 업무 완료 확인됨. PAYOUT 실행됨
  COMPLETED
  /// 구인자 취소
  CANCELLED
  /// 미달 상태로 시작 시각 경과
  EXPIRED
}

/// 제재 기록 1건. (`spec-fixed.md` §5)
///
/// **레코드를 지우지 않는다** — 분쟁 대응 근거이기 때문이다. 제재 판정은
/// 최근 180일 롤링 윈도우를 쿼리로 세는 것이고 별도 배치가 없다.
model Penalty {
  id         String        @id @default(cuid())
  userId     String
  reason     PenaltyReason
  /// 어느 공고에서 생겼나. 공고와 무관한 제재도 있을 수 있어 nullable이다
  jobPostId  String?
  occurredAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 180일 롤링 윈도우 집계가 이 순서로 훑는다 (§5)
  @@index([userId, occurredAt])
}

enum PenaltyReason {
  /// 무단 불참
  NO_SHOW
  /// 무상 취소 창(수락 +2시간)을 넘긴 취소
  LATE_CANCEL
  /// 근무 당일 취소
  SAME_DAY_CANCEL
  /// 구인자가 수락자가 있는 공고를 취소했다
  POSTER_CANCEL
}

/// 환전받을 계좌. (이슈 #30, `spec-fixed.md` §6.4.1)
///
/// **계좌번호는 암호화해서 담는다** (ADR-PAY-6). 평문으로 두면 DB 백업 하나가
/// 새는 순간 전원의 계좌가 샌다.
model ExchangeAccount {
  id       String @id @default(cuid())
  /// 회원당 한 계좌. 여러 개면 환전 요청마다 어느 계좌인지 정해야 하는데
  /// 그 단계는 §6.4에 없다.
  userId   String @unique
  bankCode String

  /// `iv:authTag:ciphertext` 한 컬럼. 셋으로 쪼개면 하나만 지워질 수 있다.
  accountNumberEncrypted String
  /// 마스킹 표시용 뒤 4자리. **평문이지만 이것만으로는 계좌를 쓸 수 없다** —
  /// 목록을 그릴 때마다 복호화하면 전 회원의 계좌번호가 메모리에 올라온다.
  accountNumberLast4     String
  holderName             String

  verificationStatus AccountVerificationStatus @default(PENDING)
  /// 왜 거절됐나. 없으면 사용자가 무엇을 고쳐야 하는지 모른다
  rejectedReason     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum AccountVerificationStatus {
  /// 아직 검증 전
  PENDING
  /// 검증 통과. stub 모드는 형식만 보고 즉시 이 상태가 된다 (§6.4.2)
  VERIFIED
  /// 형식이 틀렸거나 실명 대조에 실패했다
  REJECTED
}

/// 신청 1건. (이슈 #17, `spec-fixed.md` §4)
///
/// 이 테이블이 "누가 누구와 무엇을 약속했는가"의 진실을 갖는다. #17은 그중
/// 약속이 생기는 순간(`APPLIED`)과 수락 전에 무르는 순간(`WITHDRAWN`)까지다.
model Application {
  id          String            @id @default(cuid())
  jobPostId   String
  applicantId String
  status      ApplicationStatus @default(APPLIED)
  /// 지원 시점의 공고 버전 (AC1).
  ///
  /// **화면용 숫자가 아니다** — #21이 "내가 동의한 조건이 그 뒤에 바뀌었나"를
  /// 이 값으로 판정한다. 재지원할 때 다시 찍는 이유도 그래서다.
  appliedVersion Int
  /// 수락 시각 (#18 AC1). 아직 수락 전이면 null.
  ///
  /// **#20의 무상 취소 창(수락 +2시간)이 이 값을 기준으로 판정한다.**
  acceptedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  jobPost   JobPost @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  applicant User    @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  /// 중복 신청 방지 (§4.5). **경합에서 실제로 이기는 것은 이 제약이다.**
  /// 철회 후 재지원이 새 행이 아니라 되살리기인 것도 이 제약 때문이다.
  @@unique([jobPostId, applicantId])
  /// 구인자의 지원자 목록이 이 순서로 훑는다 (#18)
  @@index([jobPostId, status])
  /// 구직자의 "내 신청" 목록
  @@index([applicantId, status])
}

enum ApplicationStatus {
  /// 지원함. 아직 수락 전이라 자유롭게 철회할 수 있다
  APPLIED
  /// 구인자가 승인했다. 이 순간이 계약 체결
  ACCEPTED
  /// 구인자가 거절했다 (#19)
  REJECTED
  /// 수락 전에 본인이 철회했다. 무패널티 (#17)
  WITHDRAWN
  /// 공고 버전이 올라 재확인이 필요하다 (#21)
  PENDING_REACCEPT
  /// 업무 완료 확인됨. PAYOUT 실행됨 (#23)
  COMPLETED
  /// 무상 취소 창(수락 +2시간) 안의 취소 (#20)
  CANCELLED_FREE
  /// 창을 넘긴 취소. Penalty 1건 (#20)
  CANCELLED_PENALTY
  /// 바뀐 조건을 거절했다. 본인 잘못이 아니라 무패널티 (#22)
  CANCELLED_BY_VERSION_CHANGE
  /// 무단 불참. Penalty 1건 (#24)
  NO_SHOW
}

/// 인앱 알림 한 건. (이슈 #36, `spec-fixed.md` §8)
///
/// 문구를 발행 시점에 굳혀서 담는다. 공고 제목이 나중에 바뀌어도 그때 보낸
/// 알림은 그때 문구 그대로여야 하기 때문이다 (ADR-NOT-3).
model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType
  title   String
  body    String
  /// 클릭하면 갈 앱 내부 경로. 예: `/my/account`
  linkUrl String

  /// null이면 미읽음. 상태 컬럼을 따로 두지 않는 것은 ADR-AUTH-3과 같은 이유다.
  readAt    DateTime?
  createdAt DateTime  @default(now())

  /// 미읽음 카운트가 이 인덱스로 끝난다 (ADR-NOT-5)
  @@index([userId, readAt])
  /// 목록은 최신순
  @@index([userId, createdAt])
}

/// 알림 종류. `packages/shared/src/notification.ts`의 목록과 같아야 한다.
///
/// 발행자가 아직 없는 셋도 미리 넣는다 — #19·#33·#34가 각자 마이그레이션을
/// 하나씩 더 만드는 것보다 싸다.
enum NotificationType {
  /// 계좌 검증 완료 (#30)
  ACCOUNT_VERIFIED
  /// 지원 거절 (#19)
  APPLICATION_REJECTED
  /// 제재 조기 해제 (#33)
  SUSPENSION_RELEASED
  /// 환전 반려 (#34)
  EXCHANGE_REJECTED
}
