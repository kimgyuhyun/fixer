# 운영용 .env 예시. 서버의 docker-compose.prod.yml 옆에 .env로 복사해서 채운다.
# .env는 커밋되지 않는다.
#
# 모든 비밀값은 비워 둔다. 그럴듯한 값을 적어 두면 그대로 복사해서 쓰게 되고,
# 저장소에 공개된 값으로 운영하게 된다. 비어 있으면 compose가 기동 전에 멈춘다.
#   난수 생성:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# 컨테이너 안의 경로·주소(AGREEMENT_STORAGE_PATH, API 주소, DB 호스트)는
# docker-compose.prod.yml이 정한다. 여기에는 적지 않는다.

# --- PostgreSQL ---
POSTGRES_USER=fixer
# DATABASE_URL에 그대로 끼워 넣으므로 URL에 쓸 수 있는 문자만 쓴다(hex 난수 권장).
POSTGRES_PASSWORD=
POSTGRES_DB=fixer

# --- API ---
# Access 토큰(JWT) 서명 키. 아는 사람은 아무 회원으로나 로그인할 수 있다.
AUTH_JWT_SECRET=
# 포트원 웹훅 서명 검증 키. 포트원 콘솔의 값을 넣는다.
PORTONE_WEBHOOK_SECRET=
# 계좌번호 암호화 마스터 키. 한 번 정하면 바꾸지 않는다 — 바꾸면 기존 계좌를 못 읽는다.
ACCOUNT_ENCRYPTION_KEY=
# 카카오 로컬 REST API 키. 비우면 좌표 없이 주소만 저장된다.
KAKAO_REST_API_KEY=

# --- 최초 관리자 (seed 전용) ---
# docker compose -f docker-compose.prod.yml run --rm migrate prisma db seed
# 둘 중 하나라도 비면 관리자를 만들지 않는다.
ADMIN_EMAIL=
ADMIN_PASSWORD=
