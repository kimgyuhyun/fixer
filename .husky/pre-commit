# 1) 포매터 (fixer) — 스테이지된 파일을 자동 교정한다.
#    pnpm/npx를 거치지 않고 로컬 바이너리를 직접 부른다. Windows에서 훅이 셸을 통해
#    .cmd를 실행하려다 실패하는 경로를 아예 피하기 위한 것이다.
node_modules/.bin/lint-staged || exit 1

# 2) 시크릿 (leash) — 커밋 후에 알면 히스토리 재작성이 필요해 고치기 늦다. 여기서 차단한다.
#
#    gitleaks는 npm 패키지가 아니라 기기마다 바이너리를 따로 설치해야 한다(README 참고).
#    도구가 없으면 "통과"가 아니라 "검사를 못 한 것"이므로 차단한다.
#    조용히 통과시키면 시크릿 검사가 걸려 있다고 믿게 되는데, 그건 검사가 없는 것보다 나쁘다.
#    (같은 상황에서 Claude 훅은 반대로 조용히 통과시킨다 — 그쪽은 사람이 커밋 시점에
#     이 훅으로 다시 걸리기 때문이다. 마지막 방어선인 여기서는 통과시킬 수 없다.)
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "" >&2
  echo "pre-commit 중단: gitleaks를 찾을 수 없습니다." >&2
  echo "" >&2
  echo "  스테이지된 변경에 시크릿이 있는지 검사할 수 없어 커밋을 막았습니다." >&2
  echo "  설치: winget install gitleaks   (macOS: brew install gitleaks)" >&2
  echo "  설치 후 새 셸에서 다시 커밋하세요." >&2
  echo "" >&2
  exit 1
fi

gitleaks git --staged . --no-banner --redact
